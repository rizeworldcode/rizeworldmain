DirectoryIndex index.html index.php
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Enforce HTTPS and non-www domain
  RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # 301 Redirects from old WordPress URLs (case-insensitive, optional trailing slash)
  RewriteRule ^custom-website-development-services/?$ /services/custom-website-development [R=301,L,NC]
  RewriteRule ^services/graphics-design/?$ /services/graphic-design [R=301,L,NC]
  RewriteRule ^services/branding-design/?$ /services/graphic-design [R=301,L,NC]
  RewriteRule ^services/email-marketing/?$ /services/digital-marketing [R=301,L,NC]
  RewriteRule ^career/apply-support-engineer/?$ /careers [R=301,L,NC]
  RewriteRule ^about-me/?$ /about [R=301,L,NC]
  RewriteRule ^faqs/?$ /faq [R=301,L,NC]

  # Old portfolio/projects URLs to new portfolio path
  RewriteRule ^portfolio-item/(.*)/?$ /portfolio/$1 [R=301,L,NC]
  RewriteRule ^projects/(.*)/?$ /portfolio/$1 [R=301,L,NC]

  # Old case-study URLs to new case-studies path
  RewriteRule ^case-study/(.*)/?$ /case-studies/$1 [R=301,L,NC]
  RewriteRule ^case/(.*)/?$ /case-studies/$1 [R=301,L,NC]

  # Return HTTP 404 for hacked or spam URLs
  RewriteRule ^(mostbet.*|vavada.*|casino.*|olimp.*|chicken-road.*|hello-world|2024/.*|2025/.*)$ - [R=404,L,NC]

  # Dynamic Blog Sitemap & Index: Ensure newly published blogs appear immediately in sitemaps
  RewriteRule ^sitemap-blogs\.xml$ sitemap-blogs.php [L]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # 1. Direct hit on existing physical files (assets, images, scripts, styles)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. Prerendered Static Directory Fallback:
  # If index.html exists in the requested folder, serve that specific page's static HTML!
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # 3. Universal SPA routing fallback:
  # Send all non-file requests to /index.html so React Router handles dynamic routes
  # (even if a physical directory with that name exists on disk, e.g. /services or /team)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule . /index.html [L]

</IfModule>

# Custom 404: serve React SPA which renders <NotFound /> component
# IMPORTANT: Apache will set HTTP status 404, React handles the visual rendering
ErrorDocument 404 /index.html

# ----------------------------------------------------------------------
# BROWSER CACHING (mod_expires & mod_headers)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML & Manifest: Revalidate so updates take effect immediately
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 1 day"

  # Hashed CSS, JavaScript: 1 year immutable
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # Images: 1 year
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Web Fonts: 1 year
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Content-Hashed Vite assets: Immutable cache
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML: Always revalidate so new builds display immediately
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Security headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----------------------------------------------------------------------
# GZIP / DEFLATE COMPRESSION
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>
